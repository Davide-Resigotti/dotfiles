#!/usr/bin/env python3
"""
Yard Presence Popup Daemon for Niri Wayland
Listens to Home Assistant MQTT notifications on 'linux/yard_presence_popup'
and triggers the yard camera floating popup.
"""

import sys
import os
import signal
import subprocess
import logging
from datetime import datetime
import paho.mqtt.client as mqtt

# Configuration
BROKER_HOST = "homeassistant.local"
BROKER_PORT = 1883
BROKER_USER = "mqtt"
BROKER_PASS = "INSERT_MQTT_PASSWORD"
TOPIC = "linux/yard_presence_popup"
CONTROLLER = os.path.expanduser("~/.local/bin/yard-popup-camera")

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s [%(levelname)s] %(message)s",
    datefmt="%Y-%m-%d %H:%M:%S",
)

def run_controller(action: str):
    logging.info("Executing controller action: %s", action)
    try:
        subprocess.run([CONTROLLER, action], check=True)
    except Exception as exc:
        logging.error("Failed to execute %s: %s", action, exc)

def on_connect(client, userdata, flags, rc, properties=None):
    if rc == 0:
        logging.info("Connected to Mosquitto broker at %s:%s", BROKER_HOST, BROKER_PORT)
        client.subscribe(TOPIC)
        logging.info("Subscribed to topic: %s", TOPIC)
    else:
        logging.error("Connection failed with result code: %s", rc)

def on_disconnect(client, userdata, flags, rc, properties=None):
    logging.warning("Disconnected from broker (rc: %s). Reconnecting automatically...", rc)

def on_message(client, userdata, msg):
    payload = msg.payload.decode("utf-8", errors="ignore").strip().lower()
    logging.info("Received MQTT message on %s: %r", msg.topic, payload)

    if payload in ("open", "show", "on", "true"):
        run_controller("open")
    elif payload in ("close", "hide", "off", "false", "quit"):
        run_controller("close")
    elif "open" in payload:
        run_controller("open")
    elif "close" in payload:
        run_controller("close")
    else:
        logging.warning("Unknown command payload: %r", payload)

def main():
    client = mqtt.Client(
        mqtt.CallbackAPIVersion.VERSION2,
        client_id="niri-yard-popup-daemon",
    )
    client.username_pw_set(BROKER_USER, BROKER_PASS)
    client.on_connect = on_connect
    client.on_disconnect = on_disconnect
    client.on_message = on_message

    def handle_signal(sig, frame):
        logging.info("Received signal %s, shutting down...", sig)
        run_controller("close")
        client.disconnect()
        sys.exit(0)

    signal.signal(signal.SIGTERM, handle_signal)
    signal.signal(signal.SIGINT, handle_signal)

    logging.info("Starting yard presence popup daemon...")
    try:
        client.connect(BROKER_HOST, BROKER_PORT, keepalive=60)
        client.loop_forever()
    except Exception as exc:
        logging.error("Daemon exception: %s", exc)
        sys.exit(1)

if __name__ == "__main__":
    main()
