#!/usr/bin/env python3
"""Calculate next dark/light transition and schedule it via at(1).

Zero idle cost: atd sleeps until the job fires, then a one-shot apply-theme
process runs and reschedules the next transition.

Usage:
  schedule-theme-transitions            # auto-detect current state
  schedule-theme-transitions dark       # we just went dark → schedule light
  schedule-theme-transitions light      # we just went light → schedule dark
"""

import subprocess
import sys
import os
from datetime import datetime, timedelta
from zoneinfo import ZoneInfo

from astral import LocationInfo
from astral.sun import sun, twilight

TZ = ZoneInfo("Europe/Rome")
LOC = LocationInfo("Milan", "Italy", "Europe/Rome", 45.46, 9.19)
SCRIPTS = os.path.expanduser("~/.config/niri/scripts")
APPLY = f"{SCRIPTS}/apply-theme"
LOG = os.path.expanduser("~/.cache/theme-scheduler.log")

# How many seconds before the exact transition to fire (avoid edge flicker)
BUFFER = 60


def log(msg: str) -> None:
    ts = datetime.now(TZ).strftime("%H:%M:%S")
    with open(LOG, "a") as f:
        f.write(f"[{ts}] {msg}\n")


def next_transition(after: datetime, exclude_theme: str | None = None) -> tuple[datetime, str]:
    """Return (when, theme_to_apply) for the next transition after `after`.

    If exclude_theme is set, skip transitions that would apply that theme
    (e.g. after going dark, we only want to schedule light next).
    """
    # Walk up to 2 days forward to find the next dawn/dusk
    for day_offset in range(3):
        day = after.date() + timedelta(days=day_offset)
        try:
            times = sun(LOC.observer, date=day, tzinfo=TZ)
            dusk = times["dusk"]
            dawn = times["dawn"]
        except ValueError:
            continue

        candidates = []
        if dusk > after and exclude_theme != "dark":
            candidates.append((dusk, "dark"))
        if dawn > after and exclude_theme != "light":
            candidates.append((dawn, "light"))

        if candidates:
            return min(candidates, key=lambda x: x[0])

    # Fallback
    return after.replace(hour=6, minute=0, second=0, microsecond=0) + timedelta(days=1), "light"


def schedule_at(when: datetime, theme: str) -> None:
    """Schedule an at job for `when` that calls apply-theme."""
    # Clear any existing at jobs for apply-theme (avoid duplicates)
    try:
        result = subprocess.run(["atq"], capture_output=True, text=True)
        for line in result.stdout.strip().splitlines():
            job_id = line.split()[0]
            # Check if this job is ours
            check = subprocess.run(
                ["at", "-c", job_id], capture_output=True, text=True
            )
            if "apply-theme" in check.stdout:
                subprocess.run(["atrm", job_id], capture_output=True)
    except Exception:
        pass

    # Format time for at: HH:MM YYYY-MM-DD
    # `at` uses the system timezone
    time_str = when.strftime("%H:%M %Y-%m-%d")
    cmd = f'{APPLY} {theme}'
    proc = subprocess.run(
        ["at", time_str],
        input=cmd,
        capture_output=True,
        text=True,
    )
    if proc.returncode != 0:
        log(f"at scheduling failed: {proc.stderr.strip()}")
        sys.exit(1)
    log(f"scheduled {theme} at {time_str} (job {proc.stdout.strip()})")


def detect_current_theme() -> str:
    """Read current color-scheme from gsettings."""
    try:
        result = subprocess.run(
            ["dconf", "read", "/org/gnome/desktop/interface/color-scheme"],
            capture_output=True, text=True,
        )
        val = result.stdout.strip().strip("'\"")
        if "dark" in val:
            return "dark"
    except Exception:
        pass
    return "light"


def main() -> None:
    now = datetime.now(TZ)
    log(f"schedule-theme-transitions called at {now.isoformat()}")

    if len(sys.argv) > 1 and sys.argv[1] in ("dark", "light"):
        # We just switched — schedule the opposite
        exclude = sys.argv[1]
        after = now
    else:
        # Auto-detect: apply current theme, then schedule next
        current = detect_current_theme()
        log(f"current theme: {current}")
        try:
            subprocess.run(
                ["dconf", "write", "/org/gnome/desktop/interface/color-scheme",
                 f'"prefer-{current}"'],
                check=True,
            )
        except Exception as e:
            log(f"dconf write failed: {e}")
        exclude = current
        after = now

    when, theme = next_transition(after, exclude_theme=exclude)
    log(f"next transition: {theme} at {when.isoformat()}")
    schedule_at(when, theme)


if __name__ == "__main__":
    main()
