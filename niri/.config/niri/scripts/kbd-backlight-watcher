#!/usr/bin/env python3
"""
Ambient Light Sensor (ALS) & Adaptive Backlight Controller
Automatically controls keyboard backlight and screen brightness using ambient room lux:
- Keyboard Backlight: Turns OFF in bright/normal room light (> 55 lux) to save battery;
  turns ON proportionally (with delta) in dim/dark rooms (< 30 lux), strictly capped at 50%.
- Screen Brightness: Smoothly glides by 0.5% steps using a lightweight Machine Learning model
  (Kernel Anchor Spline) that learns personalized preferences from manual F1/F2 adjustments.
- Lid & Deep Sleep Integration: Dims screen to 0% and keyboard to 0% when lid is closed
  while deep sleep is inhibited (tasks running), without conflicting with deep sleep suspend.
"""

import argparse
import json
import math
import os
import signal
import subprocess
import sys
import time

# Ensure imports from current script directory work regardless of working dir
SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))
if SCRIPT_DIR not in sys.path:
    sys.path.insert(0, SCRIPT_DIR)

from adaptive_model import AdaptiveBrightnessModel, MODEL_FILE

BL_PATH = "/sys/class/backlight/apple-panel-bl"
KBD_PATH = "/sys/class/leds/kbd_backlight"
ALS_PATH = "/sys/bus/iio/devices/iio:device1/in_illuminance_input"
LAS_PATH = "/sys/bus/iio/devices/iio:device0/in_angl_raw"

CONFIG_FILE = os.path.expanduser("~/.config/niri/ambient.conf")
STATE_DIR = os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state"))
KBD_DELTA_FILE = os.path.join(STATE_DIR, "kbd_backlight_delta")
ADJUSTMENT_FILE = os.path.join(STATE_DIR, "last_manual_adjustment.json")
SAVED_BRIGHTNESS_FILE = os.path.join(
    os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "saved-screen-brightness"
)

# Default settings
DEFAULT_CONFIG = {
    "kbd_lux_dark": 30.0,
    "kbd_lux_bright": 55.0,
    "kbd_delta_pct": 0.0,
    "kbd_max_pct": 50.0,
    "auto_screen": True,
    "screen_min_pct": 5,
    "screen_max_pct": 100,
    "smooth_ramp": True,
    "ramp_step_pct": 0.5,
    "ramp_interval_ms": 50,
    "ml_learning": True,
    "ml_learning_rate": 0.75,
    "ml_settle_delay": 2.5,
    "poll_interval": 2.5,
}


def load_config():
    cfg = dict(DEFAULT_CONFIG)
    if os.path.isfile(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, "r") as f:
                for line in f:
                    line = line.strip()
                    if not line or line.startswith("#"):
                        continue
                    if "=" in line:
                        k, v = line.split("=", 1)
                        k = k.strip().lower()
                        v = v.split("#")[0].strip()
                        if k in (
                            "kbd_lux_dark",
                            "kbd_lux_bright",
                            "kbd_delta_pct",
                            "kbd_max_pct",
                            "ramp_step_pct",
                            "ml_learning_rate",
                            "ml_settle_delay",
                            "poll_interval",
                        ):
                            cfg[k] = float(v)
                        elif k in ("screen_min_pct", "screen_max_pct", "ramp_interval_ms"):
                            cfg[k] = int(v)
                        elif k in ("auto_screen", "smooth_ramp", "ml_learning"):
                            cfg[k] = v.lower() in ("true", "1", "yes", "on")
        except Exception:
            pass
    return cfg


def save_config_auto_screen(enabled):
    lines = []
    found = False
    if os.path.isfile(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, "r") as f:
                lines = f.readlines()
        except Exception:
            lines = []

    new_lines = []
    val_str = "true" if enabled else "false"
    for line in lines:
        stripped = line.strip()
        if stripped.startswith("auto_screen") and "=" in stripped:
            new_lines.append(f"auto_screen = {val_str}\n")
            found = True
        else:
            new_lines.append(line)

    if not found:
        new_lines.append(f"auto_screen = {val_str}\n")

    try:
        os.makedirs(os.path.dirname(CONFIG_FILE), exist_ok=True)
        with open(CONFIG_FILE, "w") as f:
            f.writelines(new_lines)
    except Exception:
        pass


def is_deep_sleep_inhibited():
    """Returns True if deep sleep is currently inhibited (active tasks keep awake)."""
    try:
        res = subprocess.run(
            ["systemctl", "--user", "is-active", "--quiet", "deep-sleep-inhibit.service"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        if res.returncode == 0:
            return True
        res2 = subprocess.run(
            ["pgrep", "-f", "systemd-inhibit.*handle-lid-switch.*Waybar"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        return res2.returncode == 0
    except Exception:
        return False


def get_raw_lux():
    try:
        if os.path.isfile(ALS_PATH):
            with open(ALS_PATH, "r") as f:
                return float(f.read().strip())
    except Exception:
        pass
    return None


def get_lid_angle():
    try:
        if os.path.isfile(LAS_PATH):
            with open(LAS_PATH, "r") as f:
                return int(f.read().strip())
    except Exception:
        pass
    return None


def get_display_brightness():
    try:
        with open(os.path.join(BL_PATH, "brightness"), "r") as f:
            cur = int(f.read().strip())
        with open(os.path.join(BL_PATH, "max_brightness"), "r") as f:
            max_b = int(f.read().strip())
        return cur, max_b
    except Exception:
        return None, None


def set_display_brightness(val):
    try:
        with open(os.path.join(BL_PATH, "brightness"), "w") as f:
            f.write(f"{val}\n")
        return True
    except Exception:
        return False


def get_kbd_brightness():
    try:
        with open(os.path.join(KBD_PATH, "brightness"), "r") as f:
            cur = int(f.read().strip())
        with open(os.path.join(KBD_PATH, "max_brightness"), "r") as f:
            max_b = int(f.read().strip())
        return cur, max_b
    except Exception:
        return None, None


def set_kbd_brightness(val):
    _, max_b = get_kbd_brightness()
    max_b = max_b or 255
    val = max(0, min(val, max_b))

    try:
        bfile = os.path.join(KBD_PATH, "brightness")
        if os.path.exists(bfile):
            with open(bfile, "w") as f:
                f.write(f"{val}\n")
            return True
    except (PermissionError, OSError):
        pass

    try:
        res = subprocess.run(
            [
                "busctl",
                "call",
                "org.freedesktop.UPower",
                "/org/freedesktop/UPower/KbdBacklight",
                "org.freedesktop.UPower.KbdBacklight",
                "SetBrightness",
                "i",
                str(val),
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        return res.returncode == 0
    except Exception:
        return False


def get_kbd_delta(cfg):
    try:
        if os.path.isfile(KBD_DELTA_FILE):
            with open(KBD_DELTA_FILE, "r") as f:
                val = float(f.read().strip())
                if -50.0 <= val <= 50.0:
                    return val
    except Exception:
        pass
    return float(cfg.get("kbd_delta_pct", 0.0))


def save_kbd_delta(val):
    val = max(-50.0, min(50.0, float(val)))
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        with open(KBD_DELTA_FILE, "w") as f:
            f.write(f"{val:.1f}\n")
    except Exception:
        pass


def get_last_adjustment():
    if os.path.isfile(ADJUSTMENT_FILE):
        try:
            with open(ADJUSTMENT_FILE, "r") as f:
                return json.load(f)
        except Exception:
            pass
    return None


def get_last_adjustment_timestamp():
    adj = get_last_adjustment()
    return adj.get("timestamp", 0) if adj else 0


def record_manual_adjustment(val):
    lux = get_raw_lux()
    _, disp_max = get_display_brightness()
    disp_max = disp_max or 500
    pct = round((val / disp_max) * 100.0, 1)
    lux_val = round(lux, 1) if lux is not None else 485.0
    payload = {
        "lux": lux_val,
        "pct": pct,
        "timestamp": time.time(),
        "learned": False,
    }
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        with open(ADJUSTMENT_FILE, "w") as f:
            json.dump(payload, f, indent=2)
    except Exception:
        pass

    # Immediately sync keyboard backlight to match new screen brightness
    cfg = load_config()
    raw_lux = get_raw_lux()
    lid_angle = get_lid_angle()
    mgr = AmbientBacklightManager()
    kbd_should_on = mgr.determine_kbd_state(raw_lux, lid_angle)
    kbd_cur, kbd_max = get_kbd_brightness()
    kbd_max = kbd_max or 255
    if not kbd_should_on:
        target_kbd = 0
    else:
        kbd_delta = get_kbd_delta(cfg)
        screen_pct = (val / disp_max) * 100.0
        kbd_target_pct = max(0.0, min(float(cfg["kbd_max_pct"]), screen_pct + kbd_delta))
        target_kbd = round((kbd_target_pct / 100.0) * kbd_max)
        if val > 0 and target_kbd < 1:
            target_kbd = 1
        target_kbd = max(0, min(target_kbd, round((float(cfg["kbd_max_pct"]) / 100.0) * kbd_max)))
    if kbd_cur != target_kbd:
        set_kbd_brightness(target_kbd)


class AmbientBacklightManager:
    def __init__(self):
        self.cfg = load_config()
        self.model = AdaptiveBrightnessModel()
        self.smoothed_lux = get_raw_lux()
        self.kbd_on_state = False  # Hysteresis state
        self.lid_was_closed = False
        self.saved_disp_before_lid = None
        self.running = True

    def update_smoothed_lux(self, raw_lux, alpha=0.30):
        if raw_lux is None:
            return None
        if self.smoothed_lux is None:
            self.smoothed_lux = raw_lux
        else:
            self.smoothed_lux = (alpha * raw_lux) + ((1.0 - alpha) * self.smoothed_lux)
        return self.smoothed_lux

    def determine_kbd_state(self, lux, lid_angle):
        # 1. Lid closed -> always off
        if lid_angle is not None and lid_angle <= 0:
            self.kbd_on_state = False
            return False

        # 2. No sensor -> fallback to display < 50%
        if lux is None:
            cur_disp, max_disp = get_display_brightness()
            return (cur_disp * 2 < max_disp) if (cur_disp and max_disp) else False

        # 3. Ambient lux with hysteresis
        if lux >= self.cfg["kbd_lux_bright"]:
            self.kbd_on_state = False
        elif lux <= self.cfg["kbd_lux_dark"]:
            self.kbd_on_state = True

        return self.kbd_on_state

    def check_and_learn_manual_adjustment(self):
        if not self.cfg.get("ml_learning", True):
            return False

        adj = get_last_adjustment()
        if not adj or adj.get("learned", False):
            return False

        adj_time = adj.get("timestamp", 0)
        settle = self.cfg.get("ml_settle_delay", 2.5)

        # Check if user has stopped pressing buttons for >= settle seconds
        if time.time() - adj_time >= settle:
            lux = adj.get("lux")
            pct = adj.get("pct")
            if lux is not None and pct is not None:
                rate = self.cfg.get("ml_learning_rate", 0.75)
                self.model.learn(lux, pct, learning_rate=rate)
                adj["learned"] = True
                try:
                    with open(ADJUSTMENT_FILE, "w") as f:
                        json.dump(adj, f, indent=2)
                except Exception:
                    pass
                return True
        return False

    def ramp_display(self, start_val, target_val, disp_max, kbd_max, kbd_should_be_on):
        """
        Gradual smooth transition stepping by ramp_step_pct (0.5% per step).
        Aborts immediately if user presses manual brightness keys.
        """
        step_units = max(1.0, disp_max * (self.cfg["ramp_step_pct"] / 100.0))
        interval = max(0.01, self.cfg["ramp_interval_ms"] / 1000.0)
        current = float(start_val)
        direction = 1.0 if target_val > start_val else -1.0

        initial_adj_ts = get_last_adjustment_timestamp()

        while self.running and abs(target_val - current) >= 1.0:
            # Abort ramp immediately if user pressed brightness keys
            if get_last_adjustment_timestamp() != initial_adj_ts:
                break

            current += direction * step_units
            if (direction > 0 and current > target_val) or (direction < 0 and current < target_val):
                current = float(target_val)

            int_val = round(current)
            set_display_brightness(int_val)

            # Keep keyboard backlight in sync during ramp
            if kbd_should_be_on:
                kbd_delta = get_kbd_delta(self.cfg)
                screen_pct = (int_val / disp_max) * 100.0
                kbd_target_pct = max(0.0, min(float(self.cfg["kbd_max_pct"]), screen_pct + kbd_delta))
                target_kbd = round((kbd_target_pct / 100.0) * kbd_max)
                if int_val > 0 and target_kbd < 1:
                    target_kbd = 1
                target_kbd = max(0, min(target_kbd, round((float(self.cfg["kbd_max_pct"]) / 100.0) * kbd_max)))
                set_kbd_brightness(target_kbd)

            time.sleep(interval)

    def is_manual_override_active(self, current_lux):
        adj = get_last_adjustment()
        if not adj:
            return False

        if adj.get("synced", False):
            return False

        adj_lux = adj.get("lux")
        if adj_lux is None or current_lux is None:
            return False

        # If ambient light has shifted noticeably (> 30% or 0.12 in log10 space),
        # lighting condition has changed, so auto-screen resumes
        log_cur = math.log10(max(1.0, float(current_lux)))
        log_adj = math.log10(max(1.0, float(adj_lux)))
        if abs(log_cur - log_adj) > 0.12:
            return False

        return True

    def sync(self, ramp_screen=False):
        self.cfg = load_config()
        raw_lux = get_raw_lux()
        smoothed_lux = self.update_smoothed_lux(raw_lux)
        lid_angle = get_lid_angle()

        disp_cur, disp_max = get_display_brightness()
        disp_max = disp_max or 500
        kbd_cur, kbd_max = get_kbd_brightness()
        kbd_max = kbd_max or 255

        # --- 0. Lid Closed Awareness (Zero conflict with Deep Sleep) ---
        if lid_angle is not None and lid_angle <= 0:
            self.lid_was_closed = True
            # Dim screen and keyboard to 0% while closed
            if disp_cur is not None and disp_cur > 0:
                self.saved_disp_before_lid = disp_cur
                try:
                    with open(SAVED_BRIGHTNESS_FILE, "w") as f:
                        f.write(f"{disp_cur}\n")
                except Exception:
                    pass
                set_display_brightness(0)
            if kbd_cur != 0:
                set_kbd_brightness(0)
            return 0, 0

        # Lid was closed and has just been opened: restore immediately without slow ramp
        if self.lid_was_closed:
            self.lid_was_closed = False
            ramp_screen = False

        # --- 1. Screen Brightness Auto-Adjust (Adaptive ML) ---
        if self.cfg["auto_screen"] and smoothed_lux is not None and disp_cur is not None:
            # If manual override is active for current lighting, preserve user's chosen brightness
            if not self.is_manual_override_active(smoothed_lux):
                target_pct = self.model.predict(smoothed_lux)
                target_pct = max(self.cfg["screen_min_pct"], min(self.cfg["screen_max_pct"], target_pct))
                target_val = round((target_pct / 100.0) * disp_max)

                # Deadband threshold to avoid hunting on micro-lux changes (~1.0% = 5 units)
                deadband = max(2, round(disp_max * 0.01))
                if abs(target_val - disp_cur) > deadband:
                    kbd_should_on = self.determine_kbd_state(smoothed_lux, lid_angle)
                    if ramp_screen and self.cfg.get("smooth_ramp", True):
                        self.ramp_display(disp_cur, target_val, disp_max, kbd_max, kbd_should_on)
                        disp_cur, _ = get_display_brightness()
                    else:
                        set_display_brightness(target_val)
                        disp_cur = target_val
        elif disp_cur == 0:
            # Screen is at 0 (e.g. lid just opened or woke from sleep): restore
            restore_val = getattr(self, "saved_disp_before_lid", None)
            if not restore_val and os.path.isfile(SAVED_BRIGHTNESS_FILE):
                try:
                    with open(SAVED_BRIGHTNESS_FILE, "r") as f:
                        restore_val = int(f.read().strip())
                except Exception:
                    pass
            if not restore_val:
                restore_val = round((self.model.predict(smoothed_lux or 485.0) / 100.0) * disp_max)
            set_display_brightness(max(10, restore_val))
            disp_cur = restore_val

        # --- 2. Keyboard Backlight Auto-Adjust (Follows Screen with Delta & Max 50% Cap) ---
        kbd_should_be_on = self.determine_kbd_state(smoothed_lux, lid_angle)

        if not kbd_should_be_on:
            target_kbd = 0
        else:
            kbd_delta = get_kbd_delta(self.cfg)
            screen_pct = (disp_cur / disp_max) * 100.0 if (disp_cur and disp_max) else 30.0
            kbd_target_pct = max(0.0, min(float(self.cfg["kbd_max_pct"]), screen_pct + kbd_delta))
            target_kbd = round((kbd_target_pct / 100.0) * kbd_max)
            if disp_cur and disp_cur > 0 and target_kbd < 1:
                target_kbd = 1
            target_kbd = max(0, min(target_kbd, round((float(self.cfg["kbd_max_pct"]) / 100.0) * kbd_max)))

        if kbd_cur != target_kbd:
            set_kbd_brightness(target_kbd)

        return target_kbd, disp_cur


def sync_all():
    adj = get_last_adjustment()
    if adj:
        adj["synced"] = True
        try:
            with open(ADJUSTMENT_FILE, "w") as f:
                json.dump(adj, f, indent=2)
        except Exception:
            pass
    mgr = AmbientBacklightManager()
    mgr.sync(ramp_screen=False)


def print_status():
    cfg = load_config()
    raw_lux = get_raw_lux()
    lid_angle = get_lid_angle()
    disp_cur, disp_max = get_display_brightness()
    kbd_cur, kbd_max = get_kbd_brightness()
    kbd_delta = get_kbd_delta(cfg)
    inhibited = is_deep_sleep_inhibited()

    model = AdaptiveBrightnessModel()
    predicted_pct = model.predict(raw_lux) if raw_lux is not None else None

    mgr = AmbientBacklightManager()
    kbd_should_on = mgr.determine_kbd_state(raw_lux, lid_angle)

    disp_pct = f"{(disp_cur * 100 // disp_max)}%" if (disp_cur is not None and disp_max) else "unknown"
    kbd_pct = f"{(kbd_cur * 100 // kbd_max)}%" if (kbd_cur is not None and kbd_max) else "unknown"

    print("=== Ambient & Backlight Status ===")
    print(f"Ambient Light:      {raw_lux:.1f} lux" if raw_lux is not None else "Ambient Light:      Not Available")
    print(
        f"Lid Angle:          {lid_angle}° (Sleep Mode: {'Active Tasks (keep awake, dim to 0%)' if inhibited else 'Battery Saving (deep sleep on close)'})"
        if lid_angle is not None
        else "Lid Angle:          Not Available"
    )
    print(f"Display:            {disp_cur}/{disp_max} ({disp_pct})")
    print(f"Keyboard:           {kbd_cur}/{kbd_max} ({kbd_pct})")
    print(
        f"Keyboard Auto-On:   {kbd_should_on} (thresholds: ON <= {cfg['kbd_lux_dark']:.0f} lux, OFF >= {cfg['kbd_lux_bright']:.0f} lux)"
    )
    print(f"Keyboard Cap/Delta: max {cfg['kbd_max_pct']:.0f}% (delta: {kbd_delta:+.1f}%)")
    print(f"Auto-Screen:        {'Enabled' if cfg['auto_screen'] else 'Disabled'}")
    if cfg["auto_screen"] and predicted_pct is not None:
        print(
            f"ML Model Target:    {predicted_pct:.1f}% (gradual ramp: {cfg['ramp_step_pct']}% step / {cfg['ramp_interval_ms']}ms)"
        )
    print(f"ML Learned Count:   {len(model.observations)} manual adjustments recorded")


def print_model_status():
    model = AdaptiveBrightnessModel()
    raw_lux = get_raw_lux()
    print("=== Adaptive Brightness Machine Learning Model ===")
    print(f"Model File:          {model.filepath}")
    print(f"Saved On Disk:       {'Yes' if os.path.isfile(model.filepath) else 'No (using baseline defaults)'}")
    print(f"Learned Adjustments: {len(model.observations)}")
    if raw_lux is not None:
        predicted = model.predict(raw_lux)
        print(f"Current Lux:         {raw_lux:.1f} lux --> Target: {predicted:.1f}%")
    print("\nAnchors (Ambient Lux -> Target Screen %):")
    for lux, pct in model.anchors:
        print(f"  {lux:7.1f} lux  -->  {pct:5.1f}%")
    if model.observations:
        print("\nRecent Recorded Adjustments (Lux -> User %):")
        for obs in model.observations[-5:]:
            print(f"  {obs[0]:7.1f} lux  -->  {obs[1]:5.1f}%")


def run_daemon():
    mgr = AmbientBacklightManager()
    mgr.running = True

    def handle_signal(sig, frame):
        mgr.running = False

    signal.signal(signal.SIGINT, handle_signal)
    signal.signal(signal.SIGTERM, handle_signal)

    # Initial sync on daemon launch: instant (no ramp) to hit target immediately
    mgr.sync(ramp_screen=False)

    while mgr.running:
        try:
            # 1. Check if user made a manual adjustment that is ready to learn
            mgr.check_and_learn_manual_adjustment()

            # 2. Check ambient & lid; smoothly glide by 0.5% steps if target shifted
            mgr.sync(ramp_screen=True)

            # 3. Responsive polling: sleep in small intervals to capture manual adjustments
            cfg = load_config()
            poll_interval = cfg.get("poll_interval", 2.5)
            end_time = time.time() + poll_interval
            while mgr.running and time.time() < end_time:
                time.sleep(0.25)
                mgr.check_and_learn_manual_adjustment()
        except Exception:
            time.sleep(2.0)


def main():
    parser = argparse.ArgumentParser(description="Ambient Light Backlight Watcher & Controller")
    group = parser.add_mutually_exclusive_group()
    group.add_argument("--daemon", action="store_true", help="Run background monitoring daemon")
    group.add_argument("--sync", action="store_true", help="Sync backlights once immediately")
    group.add_argument("--status", action="store_true", help="Print ambient & backlight status")
    group.add_argument(
        "--manual-adjust",
        type=int,
        metavar="VAL",
        help="Record a manual screen brightness adjustment (0-500) for ML learning",
    )
    group.add_argument(
        "--model-status", action="store_true", help="Show Adaptive Brightness ML model details"
    )
    group.add_argument(
        "--model-reset", action="store_true", help="Reset Adaptive Brightness ML model to factory baseline"
    )
    group.add_argument(
        "--toggle-auto-screen", action="store_true", help="Toggle screen auto-brightness on/off"
    )
    group.add_argument("--kbd-up", action="store_true", help="Increase keyboard delta (+5%)")
    group.add_argument("--kbd-down", action="store_true", help="Decrease keyboard delta (-5%)")
    group.add_argument(
        "--kbd-set", type=int, metavar="VAL", help="Set keyboard brightness directly (0-255)"
    )
    group.add_argument("--kbd-toggle", action="store_true", help="Toggle keyboard backlight on/off")

    # Backward-compatible bias flags
    group.add_argument("--bias-up", action="store_true", help=argparse.SUPPRESS)
    group.add_argument("--bias-down", action="store_true", help=argparse.SUPPRESS)
    group.add_argument("--bias-reset", action="store_true", help=argparse.SUPPRESS)

    args = parser.parse_args()

    if args.daemon:
        run_daemon()
    elif args.sync:
        sync_all()
    elif args.status:
        print_status()
    elif args.manual_adjust is not None:
        record_manual_adjustment(args.manual_adjust)
    elif args.model_status:
        print_model_status()
    elif args.model_reset:
        model = AdaptiveBrightnessModel()
        model.reset()
        print("Adaptive Brightness ML model reset to factory defaults (30% at 485 lux).")
        sync_all()
    elif args.toggle_auto_screen:
        cfg = load_config()
        new_state = not cfg["auto_screen"]
        save_config_auto_screen(new_state)
        print(f"Auto-Screen brightness: {'Enabled' if new_state else 'Disabled'}")
        sync_all()
    elif args.kbd_up:
        cfg = load_config()
        delta = min(30.0, get_kbd_delta(cfg) + 5.0)
        save_kbd_delta(delta)
        print(f"Keyboard delta: {delta:+.1f}%")
        sync_all()
    elif args.kbd_down:
        cfg = load_config()
        delta = max(-30.0, get_kbd_delta(cfg) - 5.0)
        save_kbd_delta(delta)
        print(f"Keyboard delta: {delta:+.1f}%")
        sync_all()
    elif args.kbd_set is not None:
        set_kbd_brightness(args.kbd_set)
        print(f"Keyboard backlight set to: {args.kbd_set}")
    elif args.kbd_toggle:
        cur, max_b = get_kbd_brightness()
        max_b = max_b or 255
        if cur and cur > 0:
            set_kbd_brightness(0)
            print("Keyboard backlight toggled OFF")
        else:
            sync_all()
            print("Keyboard backlight toggled ON")
    elif args.bias_up or args.bias_down or args.bias_reset:
        sync_all()
    else:
        sync_all()


if __name__ == "__main__":
    main()
