#!/usr/bin/env python3
"""
Keyboard Backlight Watcher and Controller
Automatically keeps keyboard backlight proportional to screen brightness when screen is under 50%,
and turns it off when screen brightness is 50% or above.
"""

import argparse
import os
import signal
import subprocess
import sys
import time

BL_PATH = "/sys/class/backlight/apple-panel-bl"
KBD_PATH = "/sys/class/leds/kbd_backlight"

STATE_DIR = os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state"))
SCALE_FILE = os.path.join(STATE_DIR, "kbd_backlight_scale")
DEFAULT_SCALE = 1.0


def get_display_brightness():
    try:
        with open(os.path.join(BL_PATH, "brightness"), "r") as f:
            cur = int(f.read().strip())
        with open(os.path.join(BL_PATH, "max_brightness"), "r") as f:
            max_b = int(f.read().strip())
        return cur, max_b
    except Exception:
        return None, None


def is_display_under_50():
    cur, max_b = get_display_brightness()
    if cur is None or max_b is None or max_b <= 0:
        return False
    # Under 50%: cur * 2 < max_b
    return (cur * 2) < max_b


def get_kbd_brightness():
    try:
        with open(os.path.join(KBD_PATH, "brightness"), "r") as f:
            cur = int(f.read().strip())
        with open(os.path.join(KBD_PATH, "max_brightness"), "r") as f:
            max_b = int(f.read().strip())
        return cur, max_b
    except Exception:
        return None, None


def get_scale():
    try:
        if os.path.isfile(SCALE_FILE):
            with open(SCALE_FILE, "r") as f:
                val = float(f.read().strip())
                if 0.1 <= val <= 3.0:
                    return val
    except Exception:
        pass
    return DEFAULT_SCALE


def save_scale(val):
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        with open(SCALE_FILE, "w") as f:
            f.write(f"{val:.2f}\n")
    except Exception:
        pass


def calculate_target_brightness(disp_cur, disp_max, kbd_max):
    """
    Calculates proportional keyboard brightness based on display brightness.
    Under 50%: scales proportionally to screen brightness (screen % * scale * kbd_max).
    At or above 50%: 0 (off).
    """
    if disp_cur is None or disp_max is None or disp_max <= 0:
        return 0

    # If display is 50% or above, keyboard backlight is off
    if (disp_cur * 2) >= disp_max:
        return 0

    scale = get_scale()
    ratio = (disp_cur / disp_max) * scale
    target = round(ratio * kbd_max)

    # If screen is on (under 50%), ensure at least level 1 so backlight is visibly on
    if disp_cur > 0 and target < 1:
        target = 1

    return max(0, min(target, kbd_max))


def set_kbd_brightness(val):
    _, max_b = get_kbd_brightness()
    max_b = max_b or 255
    val = max(0, min(val, max_b))

    # 1. Try direct sysfs write
    try:
        bfile = os.path.join(KBD_PATH, "brightness")
        if os.path.exists(bfile):
            with open(bfile, "w") as f:
                f.write(f"{val}\n")
            return True
    except (PermissionError, OSError):
        pass

    # 2. Fallback to UPower via busctl
    try:
        res = subprocess.run(
            [
                "busctl", "call", "org.freedesktop.UPower",
                "/org/freedesktop/UPower/KbdBacklight",
                "org.freedesktop.UPower.KbdBacklight",
                "SetBrightness", "i", str(val)
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False
        )
        return res.returncode == 0
    except Exception:
        return False


def sync_backlight():
    """
    Synchronizes keyboard backlight to be proportional to screen brightness (< 50%)
    or off (>= 50%).
    """
    disp_cur, disp_max = get_display_brightness()
    kbd_cur, kbd_max = get_kbd_brightness()
    kbd_max = kbd_max or 255

    target = calculate_target_brightness(disp_cur, disp_max, kbd_max)
    if kbd_cur != target:
        set_kbd_brightness(target)
    return target


def kbd_step_scale(delta):
    """
    Adjusts the proportionality scale factor.
    """
    current_scale = get_scale()
    new_scale = max(0.2, min(current_scale + delta, 2.5))
    save_scale(new_scale)
    target = sync_backlight()
    print(f"Keyboard backlight scale: {new_scale:.1f}x (current brightness: {target})")


def kbd_toggle():
    kbd_cur, kbd_max = get_kbd_brightness()
    kbd_max = kbd_max or 255
    kbd_cur = kbd_cur if kbd_cur is not None else 0

    if kbd_cur == 0:
        target = sync_backlight()
        print(f"Keyboard backlight toggled ON: {target}/{kbd_max}")
    else:
        set_kbd_brightness(0)
        print("Keyboard backlight toggled OFF")


def print_status():
    disp_cur, disp_max = get_display_brightness()
    kbd_cur, kbd_max = get_kbd_brightness()
    under_50 = is_display_under_50()
    scale = get_scale()

    disp_pct = f"{(disp_cur * 100 // disp_max)}%" if (disp_cur is not None and disp_max) else "unknown"
    kbd_pct = f"{(kbd_cur * 100 // kbd_max)}%" if (kbd_cur is not None and kbd_max) else "unknown"

    print(f"Display Backlight: {disp_cur}/{disp_max} ({disp_pct})")
    print(f"Display Under 50%: {under_50}")
    print(f"Keyboard Backlight: {kbd_cur}/{kbd_max} ({kbd_pct})")
    print(f"Keyboard Scale Factor: {scale:.2f}x")


def run_daemon():
    running = True

    def handle_signal(sig, frame):
        nonlocal running
        running = False

    signal.signal(signal.SIGINT, handle_signal)
    signal.signal(signal.SIGTERM, handle_signal)

    # Initial sync on daemon startup
    last_disp_cur, _ = get_display_brightness()
    sync_backlight()

    while running:
        try:
            time.sleep(1.0)
            disp_cur, _ = get_display_brightness()
            if disp_cur is not None and disp_cur != last_disp_cur:
                last_disp_cur = disp_cur
                sync_backlight()
        except Exception:
            time.sleep(2.0)


def main():
    parser = argparse.ArgumentParser(description="Keyboard Backlight Controller & Watcher")
    group = parser.add_mutually_exclusive_group()
    group.add_argument("--daemon", action="store_true", help="Run background monitor daemon")
    group.add_argument("--sync", action="store_true", help="Sync keyboard backlight based on current display brightness")
    group.add_argument("--kbd-up", action="store_true", help="Increase keyboard brightness scale")
    group.add_argument("--kbd-down", action="store_true", help="Decrease keyboard brightness scale")
    group.add_argument("--kbd-set", type=int, metavar="VAL", help="Set keyboard brightness directly to VAL (0-255)")
    group.add_argument("--kbd-toggle", action="store_true", help="Toggle keyboard backlight on/off")
    group.add_argument("--status", action="store_true", help="Show current backlight status")

    args = parser.parse_args()

    if args.daemon:
        run_daemon()
    elif args.sync:
        sync_backlight()
    elif args.kbd_up:
        kbd_step_scale(0.1)
    elif args.kbd_down:
        kbd_step_scale(-0.1)
    elif args.kbd_set is not None:
        set_kbd_brightness(args.kbd_set)
    elif args.kbd_toggle:
        kbd_toggle()
    elif args.status:
        print_status()
    else:
        # Default: sync
        sync_backlight()


if __name__ == "__main__":
    main()
