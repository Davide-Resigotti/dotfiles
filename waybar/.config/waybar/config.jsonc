{
  "exclusive": true,
  "reload_style_on_change": true,
  "position": "top",
  "margin-top": 0,
  "spacing": 0,
  "height": 0,
  "margin-bottom": 0,
  "modules-left": [
    "niri/workspaces",
    "custom/separator",
    "tray",
    "custom/separator2",
    "custom/sleep",
    "custom/ml_train",
    "mpris"
  ],
  "modules-center": ["custom/separator", "custom/clock", "custom/separator2"],
  "modules-right": [
    "custom/hardware",
    "custom/kdeconnect",
    "custom/separator",
    "battery",
    "custom/separator3",
    "pulseaudio",
    "custom/separator3",
    "memory",
    "custom/separator3",
    "cpu",
    "custom/separator2"
  ],
  "niri/workspaces": {
    "all-outputs": true,
    "sort-by-id": true,
    "format": "{value}"
  },
  "custom/separator": {
    "format": "[",
    "tooltip": false
  },
  "custom/separator2": {
    "format": "]",
    "tooltip": false
  },
  "custom/separator3": {
    "format": "󰿟",
    "tooltip": false
  },
  "custom/sleep": {
    "exec": "$HOME/.config/waybar/scripts/deep-sleep-toggle.sh",
    "return-type": "json",
    "signal": 7,
    "interval": 30,
    "on-click": "$HOME/.config/waybar/scripts/deep-sleep-toggle.sh --toggle"
  },
  "custom/ml_train": {
    "exec": "$HOME/.config/waybar/scripts/ml-train-status.sh",
    "return-type": "json",
    "signal": 6,
    "interval": 300,
    "on-click": "$HOME/.config/waybar/scripts/ml-train-status.sh --toggle"
  },
  "custom/hardware": {
    "exec": "$HOME/.config/waybar/scripts/hardware-power-toggle.sh",
    "return-type": "json",
    "signal": 9,
    "interval": 30,
    "on-click": "$HOME/.config/waybar/scripts/hardware-power-toggle.sh --toggle"
  },
  "custom/kdeconnect": {
    "exec": "$HOME/.config/waybar/scripts/kdeconnect-toggle.sh",
    "return-type": "json",
    "signal": 8,
    "interval": 30,
    "on-click": "$HOME/.config/waybar/scripts/kdeconnect-toggle.sh --toggle"
  },
  "custom/clock": {
    "exec": "date +'%H:%M %p - %A, %b %d' | tr '[:upper:]' '[:lower:]'",
    "interval": 60,
    "tooltip": false
  },
  "cpu": {
    "interval": 10,
    "format": "cpu {usage}%",
    "states": {
      "warning": 50,
      "critical": 80
    }
  },
  "memory": {
    "interval": 10,
    "format": "mem {percentage:02}%",
    "states": {
      "warning": 50,
      "critical": 80
    }
  },
  "battery": {
    "bat": "macsmc-battery",
    "adapter": "macsmc-ac",
    "format": "bat {capacity}%",
    "format-discharging": "bat {capacity}%",
    "format-charging": "bat {capacity}% ",
    "format-plugged": "bat {capacity}% 󰚦",
    "format-not-charging": "bat {capacity}% 󰚦",
    "format-full": "bat {capacity}% 󰚦",
    "tooltip-format-discharging": "{timeTo}",
    "tooltip-format-charging": "{timeTo}",
    "tooltip-format-plugged": "{timeTo}",
    "tooltip-format-not-charging": "{timeTo}",
    "interval": 15,
    "states": {
      "warning": 20,
      "critical": 10
    }
  },
  "pulseaudio": {
    "justify": "center",
    "format": "vol {volume}%",
    "on-click": "plasma-open-settings kcm_pulseaudio",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "tooltip-format": "Playing at {volume}%",
    "scroll-step": 5,
    "format-muted": "vol muted",
    "format-icons": {
      "headphone": "",
      "default": ["", "", ""]
    },
    "states": {
      "warning": 50,
      "critical": 10
    }
  },
  "mpris": {
    "format": "[  {dynamic} ]",
    "format-paused": "<span color='grey'>[ {status_icon} {dynamic} ]</span>",
    "title-len": 50,
    "dynamic-order": ["artist", "title"],
    "tooltip-format": "{player} ({status}):\n{artist} - {title}",
    "status-icons": {
      "paused": "󰝛"
    }
  },
  "tray": {
    "icon-size": 15,
    "spacing": 4
  }
}
