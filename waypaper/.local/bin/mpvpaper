#!/usr/bin/env python3
"""
Smart mpvpaper wrapper
Automatically chooses between lightweight swaybg and mpvpaper-bin:
- On battery OR when displaying photos: uses swaybg (0 CPU, 0 GPU, ~10MB RAM)
- On AC power when displaying videos: uses mpvpaper-bin (full 60fps video playback)
"""

import glob
import os
import subprocess
import sys
import time

MPVPAPER_BIN = os.path.expanduser("~/.local/bin/mpvpaper-bin")
if not os.path.exists(MPVPAPER_BIN):
    # Fallback to system mpvpaper if separate mpvpaper-bin does not exist
    MPVPAPER_BIN = "/usr/bin/mpvpaper"

CACHE_DIR = os.path.expanduser("~/.cache/wallpaper-frames")
VIDEO_EXTS = (".mp4", ".mkv", ".webm", ".mov", ".avi")

os.makedirs(CACHE_DIR, exist_ok=True)


def is_on_ac():
    supplies = glob.glob("/sys/class/power_supply/*")
    if not supplies:
        return True
    has_battery = False
    for p in supplies:
        try:
            with open(os.path.join(p, "type")) as ft:
                ptype = ft.read().strip()
            if ptype == "Battery":
                has_battery = True
            elif ptype in ("Mains", "USB", "USB_PD", "AC"):
                with open(os.path.join(p, "online")) as fo:
                    if fo.read().strip() == "1":
                        return True
        except Exception:
            pass
    return not has_battery


def extract_frame(video_path):
    stem = os.path.splitext(os.path.basename(video_path))[0]
    frame_path = os.path.join(CACHE_DIR, f"{stem}.jpg")
    if not os.path.isfile(frame_path):
        try:
            subprocess.run(
                ["ffmpeg", "-y", "-ss", "00:00:01", "-i", video_path, "-vframes", "1", "-q:v", "2", frame_path],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=True
            )
        except Exception:
            pass
    if os.path.isfile(frame_path):
        return frame_path
    return video_path


def get_target_file(args):
    for arg in reversed(args):
        if arg.startswith("-"):
            continue
        exp = os.path.expanduser(arg)
        if os.path.exists(exp):
            return exp
    return None


def run_swaybg(image_path):
    old_pids = []
    try:
        out = subprocess.check_output(["pgrep", "-f", "swaybg"], text=True)
        old_pids = [int(p) for p in out.strip().splitlines() if p.isdigit()]
    except Exception:
        pass

    subprocess.Popen(
        ["swaybg", "-i", image_path, "-m", "fill", "-c", "9A9996"],
        start_new_session=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL
    )

    try:
        subprocess.run(["pkill", "-f", "mpvpaper-bin"], check=False)
        for s in glob.glob("/tmp/mpv-socket-*"):
            try:
                os.remove(s)
            except OSError:
                pass
    except Exception:
        pass

    if old_pids:
        time.sleep(0.3)
        for pid in old_pids:
            try:
                os.kill(pid, 9)
            except OSError:
                pass


def main():
    raw_args = sys.argv[1:]
    target = get_target_file(raw_args)

    on_ac = is_on_ac()
    is_video = False
    if target:
        ext = os.path.splitext(target)[1].lower()
        is_video = ext in VIDEO_EXTS

    if on_ac and is_video:
        subprocess.run(["pkill", "-f", "swaybg"], check=False)
        os.execv(MPVPAPER_BIN, [MPVPAPER_BIN] + raw_args)

    image_to_show = target
    if is_video:
        image_to_show = extract_frame(target)

    if image_to_show and os.path.exists(image_to_show):
        run_swaybg(image_to_show)
    else:
        os.execv(MPVPAPER_BIN, [MPVPAPER_BIN] + raw_args)


if __name__ == "__main__":
    main()
