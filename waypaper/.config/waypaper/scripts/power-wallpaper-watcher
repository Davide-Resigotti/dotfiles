#!/usr/bin/env python3
"""
Dynamic Wallpaper Power Watcher
Switches video wallpapers between live 60fps video (on AC power) and
plain static 4K image frames with paused mpv (on battery) to eliminate battery drain.
"""

import glob
import json
import os
import select
import socket
import subprocess
import sys
import time

WP_CONFIG = os.path.expanduser("~/.config/waypaper/config.ini")
CACHE_DIR = os.path.expanduser("~/.cache/wallpaper-frames")
MPV_SOCKET = "/tmp/mpv-socket-All"
VIDEO_EXTS = (".mp4", ".mkv", ".webm", ".mov", ".avi")
_FRAME_CACHE = {}

os.makedirs(CACHE_DIR, exist_ok=True)

def is_on_ac():
    """
    Checks hardware power line online status.
    Does NOT check charging status so 75% battery limits work properly.
    """
    supplies = glob.glob("/sys/class/power_supply/*")
    if not supplies:
        return True

    has_battery = False
    for p in supplies:
        try:
            with open(os.path.join(p, "type")) as ft:
                ptype = ft.read().strip()
            if ptype == "Battery":
                has_battery = True
            elif ptype in ("Mains", "USB", "USB_PD", "AC"):
                with open(os.path.join(p, "online")) as fo:
                    if fo.read().strip() == "1":
                        return True
        except Exception:
            pass
    return not has_battery

def get_current_wallpaper():
    if not os.path.isfile(WP_CONFIG):
        return None
    try:
        with open(WP_CONFIG) as f:
            for line in f:
                line = line.strip()
                if line.startswith("wallpaper"):
                    parts = line.split("=", 1)
                    if len(parts) == 2:
                        wp = parts[1].strip()
                        return os.path.expanduser(wp)
    except Exception:
        pass
    return None

def is_video_file(path):
    if not path:
        return False
    ext = os.path.splitext(path)[1].lower()
    return ext in VIDEO_EXTS

def find_video_for_frame(frame_path):
    stem = os.path.splitext(os.path.basename(frame_path))[0]
    for ext in VIDEO_EXTS:
        pattern = os.path.join(os.path.expanduser("~/Pictures/Wallpapers"), "**", f"{stem}{ext}")
        matches = glob.glob(pattern, recursive=True)
        if matches:
            return matches[0]
    return None

def get_static_frame(video_path):
    if video_path in _FRAME_CACHE and os.path.isfile(_FRAME_CACHE[video_path]):
        return _FRAME_CACHE[video_path]

    base = os.path.basename(video_path)
    stem, _ = os.path.splitext(base)
    frame_path = os.path.join(CACHE_DIR, f"{stem}.jpg")
    if not os.path.isfile(frame_path):
        try:
            subprocess.run(
                ["ffmpeg", "-y", "-ss", "00:00:01", "-i", video_path, "-vframes", "1", "-q:v", "2", frame_path],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=True
            )
        except Exception:
            pass
    if os.path.isfile(frame_path):
        _FRAME_CACHE[video_path] = frame_path
        return frame_path
    return video_path

def send_mpv_raw(command):
    """Send command to mpv socket. Returns (success, response_dict)."""
    if not os.path.exists(MPV_SOCKET):
        return False, None
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(0.5)
            s.connect(MPV_SOCKET)
            payload = json.dumps({"command": command}) + "\n"
            s.sendall(payload.encode())
            raw = s.recv(4096).decode()
            if not raw:
                return True, None
            data = json.loads(raw.splitlines()[0])
            return True, data
    except (ConnectionRefusedError, FileNotFoundError):
        try:
            os.remove(MPV_SOCKET)
        except OSError:
            pass
        return False, None
    except Exception:
        return False, None

def send_mpv(command):
    ok, _ = send_mpv_raw(command)
    return ok

def get_mpv_property(name):
    ok, res = send_mpv_raw(["get_property", name])
    if ok and isinstance(res, dict) and res.get("error") == "success":
        return res.get("data")
    return None

def sync_power(is_ac):
    """
    Ensure mpv is in the correct state for the given power mode:
    - On AC: live video wallpaper playing, unpaused.
    - On Battery: static 4K frame loaded, paused.
    Returns True if mpv is reachable and properly synchronized, False otherwise.
    """
    if not os.path.exists(MPV_SOCKET):
        return False

    mpv_path = get_mpv_property("path")
    mpv_paused = get_mpv_property("pause")
    if mpv_path is None:
        return False

    wp = get_current_wallpaper()

    # Determine original video source
    video_source = None
    if wp and is_video_file(wp):
        video_source = wp
    elif is_video_file(mpv_path):
        video_source = mpv_path
    elif mpv_path and CACHE_DIR in mpv_path:
        video_source = find_video_for_frame(mpv_path)

    # If this is not a video wallpaper (i.e. static image wallpaper)
    if not video_source:
        if not is_ac and not mpv_paused:
            send_mpv(["set_property", "pause", True])
        elif is_ac and mpv_paused:
            send_mpv(["set_property", "pause", False])
        return True

    if is_ac:
        # On AC: live video playing unpaused
        need_load = (mpv_path != video_source)
        need_unpause = (mpv_paused is not False)
        if need_load or need_unpause:
            print(f"[{time.strftime('%T')}] Power connected (AC). Playing live video: {video_source}", flush=True)
            if need_load:
                send_mpv(["loadfile", video_source])
                time.sleep(0.05)
            send_mpv(["set_property", "pause", False])
        return True
    else:
        # On Battery: static frame loaded and paused
        frame = get_static_frame(video_source)
        need_load = (mpv_path != frame)
        need_pause = (mpv_paused is not True)
        if need_load or need_pause:
            print(f"[{time.strftime('%T')}] Power disconnected (Battery). Showing static image: {frame}", flush=True)
            if need_load:
                send_mpv(["loadfile", frame])
                time.sleep(0.05)
            send_mpv(["set_property", "pause", True])
        return True

def main():
    # Start udev monitor for power supply changes
    try:
        udev_proc = subprocess.Popen(
            ["udevadm", "monitor", "-u", "-s", "power_supply"],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True
        )
    except Exception:
        udev_proc = None

    while True:
        try:
            current_ac = is_on_ac()
            sync_power(current_ac)

            # Wait for next udev power event or 1-second watchdog tick
            if udev_proc and udev_proc.stdout:
                r, _, _ = select.select([udev_proc.stdout], [], [], 1.0)
                if r:
                    udev_proc.stdout.readline()
                    time.sleep(0.1)  # small debounce for sysfs update
            else:
                time.sleep(1.0)

        except Exception as e:
            time.sleep(1.0)

if __name__ == "__main__":
    main()
