#!/usr/bin/env python3
"""
Dynamic Power Watcher
Coordinates power-saving features across the system on AC vs Battery:
1. Wallpaper: switches between live 60fps video (AC) and zero-overhead swaybg (Battery / photos).
2. Power profile: switches TuneD via D-Bus to 'power-saver' on battery, 'balanced' on AC.
3. KDE Connect: turns off KDE Connect on battery to eliminate background UDP scans (toggleable in Waybar).
4. Akonadi & MySQL: stops Kalendarac/Akonadi on battery to save ~534MB RAM and disk writes; resumes on AC.
"""

import glob
import os
import select
import subprocess
import sys
import time

WP_CONFIG = os.path.expanduser("~/.config/waypaper/config.ini")
CACHE_DIR = os.path.expanduser("~/.cache/wallpaper-frames")
MPVPAPER_BIN = os.path.expanduser("~/.local/bin/mpvpaper-bin")
VIDEO_EXTS = (".mp4", ".mkv", ".webm", ".mov", ".avi")
_FRAME_CACHE = {}

os.makedirs(CACHE_DIR, exist_ok=True)


def is_on_ac():
    supplies = glob.glob("/sys/class/power_supply/*")
    if not supplies:
        return True

    has_battery = False
    for p in supplies:
        try:
            with open(os.path.join(p, "type")) as ft:
                ptype = ft.read().strip()
            if ptype == "Battery":
                has_battery = True
            elif ptype in ("Mains", "USB", "USB_PD", "AC"):
                with open(os.path.join(p, "online")) as fo:
                    if fo.read().strip() == "1":
                        return True
        except Exception:
            pass
    return not has_battery


def get_current_wallpaper():
    if not os.path.isfile(WP_CONFIG):
        return None
    try:
        with open(WP_CONFIG) as f:
            for line in f:
                line = line.strip()
                if line.startswith("wallpaper"):
                    parts = line.split("=", 1)
                    if len(parts) == 2:
                        wp = parts[1].strip()
                        return os.path.expanduser(wp)
    except Exception:
        pass
    return None


def is_video_file(path):
    if not path:
        return False
    ext = os.path.splitext(path)[1].lower()
    return ext in VIDEO_EXTS


def get_static_frame(video_path):
    if video_path in _FRAME_CACHE and os.path.isfile(_FRAME_CACHE[video_path]):
        return _FRAME_CACHE[video_path]

    base = os.path.basename(video_path)
    stem, _ = os.path.splitext(base)
    frame_path = os.path.join(CACHE_DIR, f"{stem}.jpg")
    if not os.path.isfile(frame_path):
        try:
            subprocess.run(
                ["ffmpeg", "-y", "-ss", "00:00:01", "-i", video_path, "-vframes", "1", "-q:v", "2", frame_path],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=True
            )
        except Exception:
            pass
    if os.path.isfile(frame_path):
        _FRAME_CACHE[video_path] = frame_path
        return frame_path
    return video_path


def set_power_profile(is_ac):
    action = "off" if is_ac else "on"
    profile = "balanced" if is_ac else "power-saver"
    try:
        subprocess.run(["sudo", "-n", "/usr/local/bin/hardware-power-toggle", action],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
        subprocess.run(["pkill", "-RTMIN+9", "waybar"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
        print(f"[{time.strftime('%T')}] Hardware power tuning synced ({action}), profile: {profile}", flush=True)
    except Exception as e:
        print(f"Failed to switch power profile: {e}", file=sys.stderr)


def sync_kdeconnect(is_ac):
    try:
        if is_ac:
            subprocess.run(["systemctl", "--user", "start", "app-org.kde.kdeconnect.daemon@autostart.service"],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
        else:
            subprocess.run(["systemctl", "--user", "stop", "app-org.kde.kdeconnect.daemon@autostart.service"],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
        # Refresh waybar kdeconnect toggle module
        subprocess.run(["pkill", "-RTMIN+8", "waybar"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    except Exception:
        pass


def sync_akonadi(is_ac):
    try:
        if is_ac:
            subprocess.run(["systemctl", "--user", "start", "app-org.kde.kalendarac@autostart.service"],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
        else:
            subprocess.run(["systemctl", "--user", "stop", "app-org.kde.kalendarac@autostart.service", "akonadi_control.service"],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    except Exception:
        pass


def sync_wallpaper(is_ac):
    wp = get_current_wallpaper()
    if not wp or not os.path.exists(wp):
        return

    is_video = is_video_file(wp)

    if is_ac and is_video:
        # Check if mpvpaper-bin is already running
        mpv_running = subprocess.run(["pgrep", "-f", "mpvpaper-bin"], stdout=subprocess.DEVNULL).returncode == 0
        if not mpv_running:
            print(f"[{time.strftime('%T')}] AC connected. Starting live video wallpaper in mpvpaper-bin: {wp}", flush=True)
            subprocess.run(["pkill", "-f", "swaybg"], check=False)
            time.sleep(0.1)
            subprocess.Popen([
                MPVPAPER_BIN, "--fork",
                "-o", "input-ipc-server=/tmp/mpv-socket-All loop panscan=1.0 --no-audio --hwdec=auto --image-display-duration=inf --background-color='#9A9996'",
                "*", wp
            ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    else:
        # On battery OR static photo: swaybg must handle it
        target = wp
        if is_video:
            target = get_static_frame(wp)

        # Stop mpvpaper-bin if running
        try:
            subprocess.run(["pkill", "-f", "mpvpaper-bin"], check=False)
            for s in glob.glob("/tmp/mpv-socket-*"):
                try:
                    os.remove(s)
                except OSError:
                    pass
        except Exception:
            pass

        # Check if swaybg is running
        sway_running = subprocess.run(["pgrep", "-f", "swaybg"], stdout=subprocess.DEVNULL).returncode == 0
        if not sway_running:
            print(f"[{time.strftime('%T')}] Showing static wallpaper via swaybg: {target}", flush=True)
            subprocess.Popen(
                ["swaybg", "-i", target, "-m", "fill", "-c", "9A9996"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL
            )


def sync_all(is_ac):
    set_power_profile(is_ac)
    sync_kdeconnect(is_ac)
    sync_akonadi(is_ac)
    sync_wallpaper(is_ac)


def main():
    try:
        udev_proc = subprocess.Popen(
            ["udevadm", "monitor", "-u", "-s", "power_supply"],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True
        )
    except Exception:
        udev_proc = None

    last_ac = None
    last_wp = None

    while True:
        try:
            current_ac = is_on_ac()
            current_wp = get_current_wallpaper()

            # Trigger sync on power state change or wallpaper path change
            if current_ac != last_ac or current_wp != last_wp:
                sync_all(current_ac)
                last_ac = current_ac
                last_wp = current_wp

            # Wait for next udev power event or 2-second tick
            if udev_proc and udev_proc.stdout:
                r, _, _ = select.select([udev_proc.stdout], [], [], 2.0)
                if r:
                    udev_proc.stdout.readline()
                    time.sleep(0.1)  # small debounce
            else:
                time.sleep(2.0)

        except Exception as e:
            time.sleep(2.0)


if __name__ == "__main__":
    main()
