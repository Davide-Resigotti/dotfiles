#!/usr/bin/env bash
set -euo pipefail

URL_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/home-assistant/url"

if [[ -f "$URL_FILE" ]]; then
    URL="$(head -n 1 "$URL_FILE" | tr -d '\r\n')"
elif [[ -n "${HA_URL:-}" ]]; then
    URL="$HA_URL"
else
    URL="http://homeassistant.local:8123"
fi

exec /usr/bin/xdg-open "$URL"
