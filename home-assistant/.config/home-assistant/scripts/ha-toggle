#!/usr/bin/env bash
set -euo pipefail

URL_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/home-assistant/url"
TOKEN_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/home-assistant/token"

if [[ -f "$URL_FILE" ]]; then
    BASE_URL="$(head -n 1 "$URL_FILE" | tr -d '\r\n')"
elif [[ -n "${HA_URL:-}" ]]; then
    BASE_URL="$HA_URL"
else
    BASE_URL="http://homeassistant.local:8123"
fi

if [[ $# -lt 1 ]]; then
    notify-send -u critical "Home Assistant" "Usage: ha-toggle <entity_id>"
    exit 1
fi

ENTITY="$1"
DOMAIN="${ENTITY%%.*}"
LABEL="$ENTITY"

if [[ ! -f "$TOKEN_FILE" ]]; then
    notify-send -u critical "Home Assistant" "Token file missing: $TOKEN_FILE"
    exit 1
fi

TOKEN="$(cat "$TOKEN_FILE")"

code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 \
    -H "Authorization: Bearer $TOKEN" \
    -H "Content-Type: application/json" \
    -d "{\"entity_id\":\"$ENTITY\"}" \
    "$BASE_URL/api/services/$DOMAIN/toggle")"

if [[ "$code" != "200" ]]; then
    notify-send -u critical "Home Assistant" "Failed to toggle $LABEL (HTTP $code)"
    exit 1
fi
