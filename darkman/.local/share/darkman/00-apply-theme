#!/usr/bin/env bash
set -euo pipefail

# Darkman transition hook. darkman calls every executable in this directory
# whenever the mode changes, passing "dark" or "light" as $1.
# - Applies the real theme switch.
# - Whenever we become light again, arms the "dark 60 min before sunset" job.

MODE="${1:?usage: 00-apply-theme dark|light}"

"$HOME/.config/niri/scripts/apply-theme" "$MODE"
